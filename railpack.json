{
  "$schema": "https://schema.railpack.com",
  "deploy": {
    "aptPackages": ["ca-certificates=20250419~deb12u2"]
  },
  "steps": {
    "install": {
      "commands": [
        "...",
        {
          "cmd": "sh -c 'git rev-parse HEAD > GIT_COMMIT 2>/dev/null || true'",
          "customName": "Record git commit"
        }
      ]
    }
  }
}
